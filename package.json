{
  "name": "oscilla",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed:orders": "node --env-file=.env.local scripts/seed-workorders.mjs",
    "seed:sim": "node --env-file=.env.local scripts/seed-sim.mjs",
    "test:db": "node --test supabase/tests/rls.test.mjs",
    "test:health": "cd health-service && .venv/bin/python -m pytest -q",
    "validate:cwru": "cd health-service && .venv/bin/python -m validation.cwru",
    "dev:health": "cd health-service && .venv/bin/uvicorn app.main:app --port 8100",
    "test": "npm run test:health && npm run test:db && npm run test:copilot",
    "test:copilot": "vitest run",
    "check:llm": "node --env-file=.env.local scripts/check-llm.mjs",
    "mock:llm": "node scripts/mock-llm.mjs",
    "test:remote": "node --env-file=.env.local node_modules/vitest/vitest.mjs run lib/agent/remote.test.ts",
    "refit:baselines": "node --env-file=.env.local scripts/refit-baselines.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
