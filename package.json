{
  "name": "oscilla",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:db": "node --test supabase/tests/rls.test.mjs",
    "test:health": "cd health-service && .venv/bin/python -m pytest -q",
    "validate:cwru": "cd health-service && .venv/bin/python -m validation.cwru",
    "dev:health": "cd health-service && .venv/bin/uvicorn app.main:app --port 8100",
    "test": "npm run test:health && npm run test:db && node --test tests/layouts.test.mjs && npm run test:copilot",
    "test:copilot": "vitest run",
    "mock:llm": "node scripts/mock-llm.mjs",
    "test:remote": "node --env-file=.env.local node_modules/vitest/vitest.mjs run lib/agent/remote.test.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
