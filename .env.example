# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by scripts and ingest. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Health service (Python) and LLM endpoint on the AMD server
HEALTH_SERVICE_URL=http://localhost:8100
# Optional shared secret; set the same value as HEALTH_API_KEY on the service.
HEALTH_SERVICE_KEY=
# OpenAI-compatible endpoint, e.g. vLLM on the AMD server: http://<host>:8000/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: none | low | medium | high. Leave empty for models that do not think by default.
LLM_REASONING_EFFORT=
# Max model calls per minute from this server (keeps a shared key under its cap). 0 = off.
LLM_MAX_RPM=15

# Dummy sensors. true: the server produces simulated readings through the same scoring and storage
# path as real ones. Set false when real gateways deliver data to /api/ingest.
SIM_ENABLED=true
SIM_TICK_MS=30000
# Shared secret a gateway sends as x-ingest-key to /api/ingest. Leave empty to disable ingest.
INGEST_API_KEY=
# Shared password for the demo accounts created by scripts/seed-demo-users.mjs (scripts only).
DEMO_PASSWORD=
